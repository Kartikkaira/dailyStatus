{
  "name": "day-status-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Day Status Tracker Monorepo with Express backend and Next.js frontend",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:push": "npm --prefix backend run prisma:push",
    "db:seed": "npm --prefix backend run seed",
    "db:generate": "npm --prefix backend run prisma:generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}

# Environment configuration for Day Status Tracker Backend
PORT=5000
NODE_ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/day_status_tracker?schema=public

# JWT Authentication Secrets and Expiries
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
